  "dependencies": [],

  "detect": {
    "missing_folders": [
      "src"
    ]
  },

  "repair": {
    "action": "create_folder",

    "target": "src"
  },

  "create_if_missing": [
    "src/components",
    "src/hooks",
    "src/pages",
    "src/services",
    "src/utils"
  ],

  "verify": {
    "exists": "src"
  },

  "rollback": {
    "delete_created_folder": true
  },

  "llm_prompt": {
    "generator": "Generate a standard React TypeScript src directory."
  },

  "metadata": {
    "author": "ProjectBuilder",
    "version": "2.0"
  }

