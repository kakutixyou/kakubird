{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectbuilder/knowledge/schema.json",

  "title": "ProjectBuilder Knowledge Schema",
  "description": "Common schema used by all ProjectBuilder knowledge JSON files.",

  "type": "object",

  "required": [
    "version"
  ],

  "properties": {
    "version": {
      "type": "string",
      "description": "Knowledge version"
    },

    "name": {
      "type": "string",
      "description": "Knowledge name"
    },

    "description": {
      "type": "string"
    },

    "author": {
      "type": "string"
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "frameworks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/framework"
      }
    },

    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },

    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },

    "keywords": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },

    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },

  "$defs": {

    "framework": {
      "type": "object",

      "properties": {

        "display_name": {
          "type": "string"
        },

        "language": {
          "type": "string"
        },

        "package_manager": {
          "type": "string"
        },

        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "template": {

      "type": "object",

      "required": [
        "name"
      ],

      "properties": {

        "name": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "path": {
          "type": "string"
        },

        "language": {
          "type": "string"
        },

        "content": {
          "type": "string"
        }
      }
    },

    "rule": {

      "type": "object",

      "required": [
        "name"
      ],

      "properties": {

        "name": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },

        "condition": {
          "type": "string"
        },

        "action": {
          "type": "string"
        }
      }
    },

    "metadata": {

      "type": "object",

      "properties": {

        "source": {
          "type": "string"
        },

        "license": {
          "type": "string"
        },

        "category": {
          "type": "string"
        },

        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }

  }
}