# 1. `memory_manager.py`

保存場所:

```text
plugins/
└── ai_memory/
    └── memory_manager.py
```

```python
from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from .conversation_memory import ConversationMemory


class MemoryManager:
    """
    AI Memory 全体を管理する。
    """

    def __init__(self, storage_dir: str | Path = ".ai_memory") -> None:
        self.storage_dir = Path(storage_dir)
        self.storage_dir.mkdir(parents=True, exist_ok=True)

        self.conversation = ConversationMemory(
            self.storage_dir / "conversation.json"
        )

        self.notes_path = self.storage_dir / "notes.json"
        self.tasks_path = self.storage_dir / "tasks.json"
        self.files_path = self.storage_dir / "files.json"

    # -------------------------------------------------
    # Public API
    # -------------------------------------------------

    def record_interaction(
        self,
        user_message: str,
        assistant_message: str,
        notes: list[str] | None = None,
        tasks: list[dict[str, Any]] | None = None,
        files: list[dict[str, Any]] | None = None,
    ) -> None:
        """
        1 回の会話結果をすべて保存する。
        """

        # 会話履歴
        self.conversation.add("user", user_message)
        self.conversation.add("assistant", assistant_message)

        # メモ
        if notes:
            self.append_unique_items(self.notes_path, notes)

        # タスク
        if tasks:
            self.save_json(self.tasks_path, tasks)

        # 関連ファイル
        if files:
            self.save_json(self.files_path, files)

    # -------------------------------------------------
    # Helpers
    # -------------------------------------------------

    def load_json(self, path: Path, default):
        if not path.exists():
            return default

        try:
            with path.open("r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return default

    def save_json(self, path: Path, data) -> None:
        with path.open("w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)

    def append_unique_items(self, path: Path, items: list[str]) -> None:
        existing = self.load_json(path, [])

        for item in items:
            if item not in existing:
                existing.append(item)

        self.save_json(path, existing)
```

